{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "text"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "content": {
      "type": "blocks"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "cover_url": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "blog_category": {
      "type": "enumeration",
      "default": "Industry News",
      "enum": [
        "Industry News",
        "Manufacturing Tips",
        "Fabric Guide",
        "Brand Startup",
        "OEM vs ODM",
        "Product Showcase"
      ]
    }
  }
}
